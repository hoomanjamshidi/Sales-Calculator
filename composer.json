{
  "name": "hooman/sales-calculator",
  "description": "Persian WooCommerce product sales reports",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Hooman Jamshidi",
      "homepage": "https://hoomanjamshidi.ir"
    }
  ],
  "require": {
    "php": ">=8.0",
    "mpdf/mpdf": "^8.2.5"
  },
  "require-dev": {
    "php-stubs/woocommerce-stubs": "^11.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "SalesCalculator\\": "src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.0.2"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
